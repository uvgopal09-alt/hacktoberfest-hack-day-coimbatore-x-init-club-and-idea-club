# Copy this file to .env and fill in only what you need.
# The .env file is git-ignored. Keep real keys there and never commit them.

# Leave LLM_API_KEY empty to use the built-in keyword answers (no account needed).
# Add a key to answer with an AI model that uses only your campus information.
LLM_API_KEY=
# Any OpenAI-compatible Chat Completions base URL.
LLM_BASE_URL=https://api.openai.com/v1
# Model name at that provider.
LLM_MODEL=gpt-4.1-mini

# Campus information file (Markdown), relative to the project folder.
CAMPUS_INFO_FILE=data/campus-info.md

# Web server. Use HOST=127.0.0.1 to accept connections only from this computer.
PORT=3000
HOST=0.0.0.0
